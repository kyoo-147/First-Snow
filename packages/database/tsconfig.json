{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "paths": {
      "@agentkid/domain": ["../domain/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "seeds/**/*.ts"],
  "exclude": ["node_modules"]
}
