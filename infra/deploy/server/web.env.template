# Copy this file to /opt/agentkid/web.env on the server before first boot.
# Bootstrap asset mapping:
# - `infra/deploy/server/compose.yaml` -> `/opt/agentkid/compose.yaml`
# - `infra/deploy/server/Caddyfile` -> `/opt/agentkid/Caddyfile`
# - `infra/deploy/server/web.env.template` -> `/opt/agentkid/web.env`
# - `infra/deploy/server/db.env.template` -> `/opt/agentkid/db.env`
# At server runtime, `env_file: ./web.env` is safe because it is resolved
# relative to the deployed `/opt/agentkid/compose.yaml`.
#
# Repo-local validation only:
# - Temporarily copy this file to `infra/deploy/server/web.env`
# - Run `docker compose --env-file infra/deploy/server/web.env -f
#   infra/deploy/server/compose.yaml config`
# - Remove the temporary repo-local `web.env` after validation
# `--env-file ...` is resolved relative to the caller's current working
# directory, unlike `env_file: ./web.env` in the compose file.
WEB_IMAGE=macdaiqua147/agentkid-web:git-<shortsha>
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_MARKETING_URL=https://agentkid.io.vn
NEXT_PUBLIC_APP_URL=https://app.agentkid.io.vn
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable
DATABASE_REMOTE_HOST=
DATABASE_REMOTE_PORT=5432
DATABASE_SSH_TUNNEL=
AUTH_SECRET=
AUTH_SESSION_COOKIE_NAME=agentkid_session
# Store this as a single-line JSON string. If your source credentials are in a
# file, compact them first before writing the value into /opt/agentkid/web.env.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
