# Copy this file to /opt/agentkid/db.env on the server before first DB boot.
# Do not commit the real /opt/agentkid/db.env values.

POSTGRES_DB=agentkid
POSTGRES_USER=agentkid_app
POSTGRES_PASSWORD=replace-with-long-random-password

# Keep this internal to Docker unless an explicitly approved tunnel/VPN pattern is used.
PGDATA=/var/lib/postgresql/data/pgdata
