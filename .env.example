# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/agentkid

# Session signing secret (generate: openssl rand -base64 32)
# Must be at least 32 characters
SESSION_SECRET=your-session-secret-here-at-least-32-chars-long

# Child session signing secret (separate key from parent secret)
# Must be at least 32 characters
CHILD_SESSION_SECRET=your-child-session-secret-here-at-least-32-chars

# Node environment
NODE_ENV=development

# Optional OpenAI-compatible text companion provider.
# Without a key, companion messaging fails closed with PROVIDER_UNAVAILABLE.
# Remote base URLs must use HTTPS; loopback HTTP is allowed for a local provider.
COMPANION_OPENAI_API_KEY=
COMPANION_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional comma-separated pool. When present, this takes precedence over the single model.
# 9Router example: free,opencode,navin-coding (cheap/free first, premium fallback last).
COMPANION_PROVIDER_MODELS=
COMPANION_OPENAI_MODEL=gpt-4o-mini
# failover always starts with the first model; round-robin rotates the first model per request.
COMPANION_PROVIDER_ROUTING=failover
COMPANION_PROVIDER_RETRIES_PER_MODEL=0
COMPANION_PROVIDER_MAX_ATTEMPTS=3
COMPANION_PROVIDER_TIMEOUT_MS=15000
COMPANION_PROVIDER_MAX_BYTES=65536
