# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/agentkid

# Session signing secret (generate: openssl rand -base64 32)
# Must be at least 32 characters
SESSION_SECRET=your-session-secret-here-at-least-32-chars-long

# Child session signing secret (separate key from parent secret)
# Must be at least 32 characters
CHILD_SESSION_SECRET=your-child-session-secret-here-at-least-32-chars

# Node environment
NODE_ENV=development

# Optional Companion AI Providers:
# Provider selection (optional explicit override: deepseek | gemini | openai):
COMPANION_PROVIDER=

# 1. DeepSeek provider (OpenAI-compatible)
# Without credentials, companion messaging fails closed with PROVIDER_UNAVAILABLE.
COMPANION_DEEPSEEK_API_KEY=
COMPANION_DEEPSEEK_BASE_URL=https://api.deepseek.com
COMPANION_DEEPSEEK_MODEL=deepseek-chat
COMPANION_DEEPSEEK_MODELS=

# 2. Google Gemini provider
# Server-only comma-separated pool or JSON array of API keys.
# Rotates keys deterministically round-robin; per-key cooldown on transient quota (429).
GOOGLE_AI_API_KEYS=
COMPANION_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
COMPANION_GEMINI_MODEL=gemini-1.5-flash
COMPANION_GEMINI_MODELS=
COMPANION_GEMINI_COOLDOWN_MS=60000

# 3. OpenAI / Generic OpenAI-compatible provider
COMPANION_OPENAI_API_KEY=
COMPANION_OPENAI_BASE_URL=https://api.openai.com/v1
COMPANION_OPENAI_MODEL=gpt-4o-mini
COMPANION_PROVIDER_MODELS=

# Shared Provider Settings
# failover starts with first model; round-robin rotates first model per request.
COMPANION_PROVIDER_ROUTING=failover
COMPANION_PROVIDER_RETRIES_PER_MODEL=0
COMPANION_PROVIDER_MAX_ATTEMPTS=3
COMPANION_PROVIDER_TIMEOUT_MS=15000
COMPANION_PROVIDER_MAX_BYTES=65536
