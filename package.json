{
  "name": "agentkid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gateway": "esbuild src/server/companion/gateway-cli.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/companion-gateway.cjs",
    "start": "next start",
    "start:gateway": "node dist/companion-gateway.cjs",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "safety:worker": "tsx src/server/safety/run-worker.ts",
    "test": "vitest run && npm run test:contracts",
    "test:contracts": "node --test src/components/auth/auth-contracts.test.mjs src/components/safety/safety-contracts.test.mjs src/lib/__tests__/learning-client.test.ts && tsx --test src/__tests__/companion/*.test.ts && node --test src/vtuber-app/src/__tests__/voice-client-contracts.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "@emotion/react": "^11.14.0",
    "@ricky0123/vad-web": "^0.0.30",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^5.9.6",
    "lucide-react": "^1.18.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.26.0",
    "postgres": "^3.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.4",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.22.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
